@model List<AnimeTracker.Models.Anime>

<h1>@ViewBag.Message</h1>

<h2>Mina anime</h2>
<p>@ViewData[index: "Info"], totalt @ViewBag.TotalEpisodes avsnitt (ca @ViewBag.Hours timmar).</p>

@foreach (var anime in Model)
{
    <h3>@anime.Title @(anime.IsFavorite ? "<3" : "")</h3>
    <p>Antal avsnitt: @anime.TotalNrEpisodes</p>
}